# S3Vault configuration template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never
# be committed. Every value here is a placeholder or a local default.
#
# Generate the secrets first:
#   openssl rand -base64 32   # KEK_BASE64
#   openssl rand -base64 24   # POSTGRES_PASSWORD
#   openssl rand -hex 20      # STORAGE_ROOT_ACCESS_KEY
#   openssl rand -base64 40   # STORAGE_ROOT_SECRET_KEY

# --------------------------------------------------------------- public
PUBLIC_HOSTNAME=s3.example.com
S3_ENDPOINT=https://s3.example.com
CONSOLE_URL=https://s3.example.com

# Host ports the reverse proxy binds. Keep 80/443 unless something else needs them.
S3VAULT_HTTP_PORT=80
S3VAULT_HTTPS_PORT=443

# ---------------------------------------------------------------- engine
STORAGE_ENGINE=seaweedfs
# Resolved on the internal Docker network; never published to the host.
STORAGE_ENGINE_ENDPOINT=http://seaweedfs:8333
STORAGE_ADDRESSING_STYLE=path
STORAGE_REGION=us-east-1
# Engine credentials. These grant full access to the engine and must never be
# given to an end user or exposed to the browser.
STORAGE_ROOT_ACCESS_KEY=REPLACE_ME_ENGINE_ACCESS_KEY
STORAGE_ROOT_SECRET_KEY=REPLACE_ME_ENGINE_SECRET_KEY

# -------------------------------------------------------------- database
POSTGRES_DB=s3vault
POSTGRES_USER=s3vault
POSTGRES_PASSWORD=REPLACE_ME_STRONG_DB_PASSWORD
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_S=5

# --------------------------------------------------------------- secrets
# 32 bytes, base64. Encrypts S3 secret access keys at rest. Rotating it makes
# every existing credential undecryptable; see docs/SECURITY.md#kek-rotation.
KEK_BASE64=REPLACE_ME_32_BYTE_BASE64_KEY
# Alternatively mount a file and use KEK_FILE=/run/secrets/s3vault_kek

# ------------------------------------------------------------- bootstrap
# Optional. Creates the first administrator when no administrator exists.
# Remove the password from the environment after the first sign-in.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PASSWORD_MIN_LENGTH=12

# ---------------------------------------------------------------- sessions
SESSION_TTL_S=3600
SESSION_IDLE_TTL_S=900
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=s3vault_session
CSRF_COOKIE_NAME=s3vault_csrf
CSRF_HEADER_NAME=X-CSRF-Token
LOGIN_RATE_LIMIT_PER_MIN=5
API_RATE_LIMIT_PER_MIN=600

# ---------------------------------------------------------------- uploads
MAX_OBJECT_BYTES=5368709120
# SeaweedFS requires >= 5 MiB per part once a multipart upload has 2+ parts.
MIN_PART_BYTES=5242880
MAX_PART_BYTES=104857600
MULTIPART_THRESHOLD_BYTES=104857600
# Smaller than MAX_OBJECT_BYTES: large objects use multipart or presigned upload.
REQUEST_BODY_LIMIT_BYTES=8388608
PRESIGN_TTL_S=900
PRESIGN_MAX_TTL_S=3600

# ----------------------------------------------------------------- quotas
# -1 means unlimited.
DEFAULT_USER_QUOTA_BYTES=-1
DEFAULT_BUCKET_QUOTA_BYTES=-1
DEFAULT_MAX_OBJECT_BYTES=5368709120
MAX_BUCKETS_PER_USER=100

# ----------------------------------------------------------------- proxy
# Number of reverse-proxy hops in front of the API. Must be >= 1 in production
# so client IP attribution comes from the proxy, not from spoofable headers.
TRUSTED_PROXY_HOPS=1

# --------------------------------------------------------- safety gates
# Destructive operations fail closed unless these are satisfied.
S3VAULT_REQUIRE_DRY_RUN=0
S3VAULT_REQUIRE_BACKUP=0
S3VAULT_ALLOW_PRODUCTION_CHANGES=0
S3VAULT_BACKUP_DIR=/backups
S3VAULT_BACKUP_RETENTION_DAYS=14

# ------------------------------------------------------------- operations
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true